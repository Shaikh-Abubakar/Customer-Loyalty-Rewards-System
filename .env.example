# Copy this file to .env and replace the placeholders on your machine.
# Never commit .env. This file contains placeholders only.
APP_NAME="Customer Loyalty Rewards"
APP_ENV=development
APP_BASE_URL=http://loyalty.local
APP_TIMEZONE=UTC

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=customer_loyalty
DB_USER=loyalty_app
DB_PASSWORD=replace-this-with-a-local-password

# 0 is for localhost HTTP only; HTTPS is detected automatically.
SESSION_COOKIE_SECURE=0
SESSION_IDLE_TIMEOUT=1800
SESSION_COOKIE_SAMESITE=Lax

# Stage 5 code claiming: generate at least 32 random bytes, Base64-encode locally,
# replace the placeholder and register the key once with bin/register_hmac_key.php.
# Never use this placeholder as a real HMAC key or commit a real key.
HMAC_ACTIVE_KEY_ID=1
HMAC_KEY_1=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_BASE64
